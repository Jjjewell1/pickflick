# PickFlick Environment Variables
# Copy this file to .env and fill in your values

# SQLite database path (relative to project root)
DATABASE_URL="file:./dev.db"

# Jellyfin server URL (include port if not default 80/443)
JELLYFIN_URL="http://192.168.1.100:8096"

# Jellyfin API key — generate one in Jellyfin Dashboard > API Keys
JELLYFIN_API_KEY="your-api-key-here"

# Public Jellyfin URL (used for poster images in the browser)
# Usually the same as JELLYFIN_URL for local network access
NEXT_PUBLIC_JELLYFIN_URL="http://192.168.1.100:8096"

# OpenAI API key (optional — enables AI movie suggestions, pick explainer, and night recaps)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
